# ── Generated color files ──────────────────────────────────────────────────
#
# All of these derive from theme/palettes.py. Versioning them would create a
# conflict on every theme switch, and a fresh clone recreates them with:
#
#   ~/.config/theme/apply.py
#
waybar/colors.css
swaync/colors.css
wlogout/colors.css
rofi/colors.rasi
kitty/theme.conf
hypr/conf/colors.lua
btop/themes/tema.theme

# The active variant is machine state, not configuration.
theme/current

# ── Caches ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── Nothing was customised here ────────────────────────────────────────────
#
# lazygit runs entirely on its defaults (see lazygit/README.md), so the empty
# config.yml carries no information. lazygit recreates it on first run.
lazygit/config.yml

# Written by applications registering themselves as a URL handler, not by hand.
mimeapps.list

# ── Configs written by the applications themselves ─────────────────────────
#
# These are data and session state (tokens, cache, history), not config you
# wrote. Several contain credentials.
discord/
obsidian/
spotify/
mozilla/
pulse/
dconf/
go/
nwg-look/

# ── Also generated by theme/apply.py ───────────────────────────────────────
#
# The GTK settings.ini and colors.css are rewritten on every variant switch.
# gtk.css is yours, so it stays.
gtk-3.0/settings.ini
gtk-4.0/settings.ini
gtk-4.0/colors.css

# ── Screenshots ────────────────────────────────────────────────────────────
#
# The README images ARE versioned — that is what makes the repository explain
# itself on GitHub. For a lighter repo, uncomment:
# .assets/
# **/.assets/
