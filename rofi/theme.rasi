/* rofi launcher appearance.
 *
 * The colors come from colors.rasi, generated by ~/.config/theme/apply.py.
 * Don't write hex here; switch the variant with SUPER+SHIFT+T.
 *
 * The gallery theme, used by the wallpaper and theme pickers, is a separate
 * file: gallery.rasi, a horizontal strip with large thumbnails.
 *
 * To inspect the element tree: rofi -show drun -dump-theme
 */

@import "colors"

* {
    /* Semantic aliases, so changing the palette only touches this block. */
    texto:         @text;
    texto-fraco:   @overlay1;
    destaque:      @lavender;
    destaque-alt:  @mauve;
    urgente:       @red;
    ativo:         @teal;

    background-color: transparent;
    text-color:       @texto;
    font:             "SpaceMono Nerd Font 12";
}

/* ── Window ──────────────────────────────────────────────────────────────── */
window {
    transparency:  "real";      /* lets the Hyprland blur do its work */
    location:      center;
    anchor:        center;
    width:         780px;

    /* Translucent, like the gallery strip, so the wallpaper shows through. */
    background-color: rgba(30, 30, 46, 0.92);

    /* No hard border, just a hairline outline to separate it from the background. */
    border:        1px;
    border-color:  rgba(180, 190, 254, 0.25);
    border-radius: 20px;

    padding:  0;
    children: [ mainbox ];
}

mainbox {
    padding:  20px;
    spacing:  16px;
    children: [ inputbar, message, listview, mode-switcher ];
}

/* ── Search bar ──────────────────────────────────────────────────────────── */
inputbar {
    background-color: rgba(49, 50, 68, 0.55);
    border:           1px;
    border-color:     rgba(180, 190, 254, 0.18);
    border-radius:    14px;
    padding:          14px 18px;
    spacing:          14px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:     @destaque;
    vertical-align: 0.5;
    font:           "SpaceMono Nerd Font 13";
}

entry {
    placeholder:       "what are you looking for?";
    placeholder-color: @texto-fraco;
    vertical-align:    0.5;
    cursor:            text;
}

/* ── List ────────────────────────────────────────────────────────────────── */
listview {
    columns:      1;
    lines:        8;
    fixed-height: false;      /* shrinks when there are few results */
    scrollbar:    true;
    spacing:      6px;
    cycle:        true;
    dynamic:      true;
    background-color: transparent;
}

scrollbar {
    handle-color:     @destaque;
    handle-width:     4px;
    border-radius:    4px;
    background-color: transparent;
}

element {
    padding:       12px 16px;
    spacing:       14px;
    border-radius: 12px;
    cursor:        pointer;
    background-color: transparent;
}

element normal.normal { text-color: @texto; }
element normal.urgent { text-color: @urgente; }
element normal.active { text-color: @ativo; }

/* Item under the cursor: a subtle highlight, not a jump to the full color. */
element alternate.normal { text-color: @texto; }

/* Selected item: a translucent light card plus an accent bar on the left.
   Obvious without shouting, matching the gallery. */
element selected.normal {
    background-color: rgba(180, 190, 254, 0.20);
    text-color:       @texto;
    border:           0px 0px 0px 3px;
    border-color:     @destaque;
}

element selected.urgent {
    background-color: rgba(243, 139, 168, 0.22);
    border-color:     @urgente;
}

element selected.active {
    background-color: rgba(148, 226, 213, 0.22);
    border-color:     @ativo;
}

element-icon {
    size:           30px;
    vertical-align: 0.5;
    cursor:         inherit;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    cursor:         inherit;
    text-color:     inherit;
    highlight:      bold;   /* emphasizes the part that matched the search */
}

/* ── Mode tabs (apps / run / windows) ────────────────────────────────────── */
mode-switcher {
    spacing: 10px;
}

button {
    padding:          10px;
    border-radius:    12px;
    background-color: rgba(49, 50, 68, 0.45);
    text-color:       @texto-fraco;
    cursor:           pointer;
}

button selected {
    background-color: @destaque;
    text-color:       @crust;
}

/* ── Messages (the -mesg passed by the scripts) ──────────────────────────── */
message {
    background-color: rgba(49, 50, 68, 0.45);
    border-radius:    12px;
    padding:          10px 16px;
}

textbox {
    text-color:     @texto-fraco;
    vertical-align: 0.5;
}
