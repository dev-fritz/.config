/* rofi behavior.
 *
 * The look lives in theme.rasi and the colors in colors.rasi (generated by
 * ~/.config/theme/apply.py). Only behavior is configured here.
 *
 * This is rofi 2.0 with native Wayland support; it does not go through XWayland.
 *
 * Where it is used:
 *   SUPER + A          application launcher (drun mode)
 *   SUPER + V          clipboard history
 *   SUPER + SHIFT + W  wallpaper picker
 *   SUPER + SHIFT + T  theme variant picker
 *
 * Test with: rofi -show drun
 */

configuration {
    /* Available modes, cycled with Shift+Left / Shift+Right.
         drun    applications with a .desktop file (the real launcher)
         run     any binary on the PATH
         window  switch between open windows */
    modes: "drun,run,window";

    /* Application icons. "Adwaita" is what exists on this machine; for nicer
       icons run `sudo pacman -S papirus-icon-theme` and switch this to
       "Papirus-Dark". */
    show-icons:  true;
    icon-theme:  "Adwaita";

    /* Only the app name in the list, without the .desktop comment, which makes
       every row far too long. */
    drun-display-format: "{name}";

    /* Label for each mode, with an icon. */
    display-drun:   " apps";
    display-run:    " run";
    display-window: " windows";

    /* Sort by usage frequency, so what you open most rises to the top. */
    sorting-method:   "fzf";
    sort:             true;
    matching:         "fuzzy";

    /* Don't close on an accidental click outside the window. */
    click-to-exit: true;

    /* Control+h/j/k/l are deliberately NOT rebound here: in rofi they are
       already taken by delete-character, accept-entry, delete-to-end-of-line
       and complete. Overriding them makes rofi open with an error window
       ("Binding 'Control+j' is already bound").

       The defaults that already work well:
         Ctrl+n / Ctrl+p    move down / up the list (same as blink.cmp)
         Shift+left/right   switch mode (apps / run / windows)
         Ctrl+Tab           the same
         Esc                cancel
       List them all with: rofi -show drun -list-keybindings */
}

@theme "theme"
